# Dependencies and build output, at any depth. Written at the repo root rather than
# per-package: this was missed twice by adding a package and forgetting its own ignore file.
node_modules/
dist/
build/
.svelte-kit/
*.tsbuildinfo

# The host's own directory, written beside the source during a Vercel build. Never ours, and
# until it was ignored every deploy's health file read `clean: false` because of it.
.vercel/

.DS_Store
.env
.env.*
!.env.example

# Seeder working files: the CSV is the artefact, these are not.
data/regions/*/.cache/
data/regions/*/.seed-report.json
