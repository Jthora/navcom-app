{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run verify:deploy --workspace navcom-web",
  "installCommand": "npm install",
  "outputDirectory": "web/build",
  "framework": null,
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
