{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node web/scripts/deploy-gate.mjs",
  "installCommand": "npm install",
  "outputDirectory": "web/build",
  "framework": null,
  "redirects": [
    { "source": "/grid", "destination": "/", "permanent": false },
    { "source": "/grid/", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "content-security-policy",
          "value": "connect-src 'self' wss: ws: https://earthquake.usgs.gov https://eonet.gsfc.nasa.gov https://www.gdacs.org https://api.weather.gov"
        }
      ]
    },
    {
      "source": "/tiles/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/directory.json",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "x-robots-tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/console-regions.json",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "x-robots-tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/console-index/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "x-robots-tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/_ipfs/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "x-robots-tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/directory/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, must-revalidate, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
