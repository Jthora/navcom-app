{
  "name": "navcom-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "budget": "node scripts/budget.mjs",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:data": "vite-node scripts/check-data.ts",
    "core": "npm --prefix ../packages/core run build",
    "dev": "vite dev",
    "prebuild": "npm run core",
    "precheck": "npm run core",
    "pretest": "npm run core",
    "preview": "vite preview",
    "test": "vitest run --reporter=default --reporter=json --outputFile=.vitest.json",
    "receipt": "node scripts/receipt.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "car": "node scripts/car.mjs",
    "pin": "node scripts/pin.mjs",
    "announce": "node scripts/announce.mjs",
    "node-key": "node scripts/node-key.mjs",
    "wellknown": "node scripts/well-known.mjs",
    "test:browser": "node scripts/browser-tests.mjs",
    "test:watch": "vitest",
    "verify": "npm run check && npm run check:data && npm run build && npm run car && npm run pin && npm run announce && npm run test && npm run test:browser && npm run receipt && npm run wellknown && npm run budget && npm run check:secrets",
    "verify:deploy": "npm run check && npm run check:data && npm run build && npm run car && npm run pin && npm run announce && npm run test && npm run receipt && npm run wellknown && npm run budget && npm run check:secrets",
    "test:pin": "node scripts/verify-pin.mjs",
    "test:relay": "playwright test real-relay.spec.ts --config playwright.relay.config.ts",
    "test:webkit": "playwright test --config playwright.webkit.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^26.2.0",
    "ipfs-car": "^3.1.0",
    "marked": "^12.0.2",
    "node-html-parser": "^9.0.1",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@navcom/core": "file:../packages/core",
    "@paulmillr/qr": "^0.3.0"
  }
}
