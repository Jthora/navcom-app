{
  "name": "navcom-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "budget": "node scripts/budget.mjs",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:data": "vite-node scripts/check-data.ts",
    "core": "npm --prefix ../packages/core run build",
    "dev": "vite dev",
    "prebuild": "npm run core",
    "precheck": "npm run core",
    "pretest": "npm run core",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "node scripts/browser-tests.mjs",
    "test:watch": "vitest",
    "verify": "npm run check && npm run check:data && npm run build && npm run test && npm run test:browser && npm run budget",
    "verify:deploy": "npm run check && npm run check:data && npm run build && npm run test && npm run budget"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^26.2.0",
    "marked": "^12.0.2",
    "node-html-parser": "^9.0.1",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-node": "^2.1.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@navcom/core": "file:../packages/core",
    "@paulmillr/qr": "^0.3.0"
  }
}
