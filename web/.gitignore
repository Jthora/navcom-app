.svelte-kit/
build/
.env
.env.*
!.env.example
.DS_Store

# Playwright: traces and screenshots from failures. Artefacts, not source.
test-results/
playwright-report/

# The node key that signs artifact pointers. Generated by `npm run node-key`,
# never committed — the pubkey is the public half and is published at a well-known path.
.navcom-node-key

# Vitest's JSON report, read by scripts/receipt.mjs and deleted once recorded.
# A stale one is a number a later run could publish as its own.
.vitest.json
