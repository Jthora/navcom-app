{
  "name": "@navcom/watchtower",
  "version": "0.1.0",
  "description": "NavCom Watchtower \u2014 Session One. A daemon that holds an in-memory watch board and speaks Nostr to a public relay, plus a CLI client that signs on/off and sends signals to it.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Jono Tho'ra (Jordan Tra\u00f1a)",
  "private": true,
  "bin": {
    "watchtower-daemon": "./dist/daemon/index.js",
    "watchtower-cli": "./dist/client/index.js",
    "navcom-escalation": "dist/escalation/index.js",
    "navcom-pager": "./dist/pager/index.js",
    "navcom-push": "./dist/push/index.js",
    "navcom-promote": "./dist/promote/index.js",
    "navcom-relay-check": "./dist/relay/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "tsx src/client/index.ts",
    "core": "npm --prefix ../core run build",
    "daemon": "tsx src/daemon/index.ts",
    "escalation": "tsx src/escalation/index.ts",
    "lint": "eslint src test",
    "prebuild": "npm run core",
    "pretest": "npm run core",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@navcom/core": "file:../core",
    "@types/web-push": "^3.6.4",
    "commander": "^12.1.0",
    "nostr-tools": "^2.19.4",
    "smol-toml": "^1.3.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^24.13.0",
    "@types/ws": "^8.5.13",
    "eslint": "^9.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
