{
  "name": "@navcom/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Attestations, crypto, wire format and board model. Shared by the node and every client.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./directory": {
      "types": "./dist/directory/index.d.ts",
      "default": "./dist/directory/index.js"
    },
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "verify": "npm run check && npm run build && npm test"
  },
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "@noble/post-quantum": "^0.7.0",
    "nostr-tools": "^2.10.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "files": [
    "dist",
    "src"
  ]
}
